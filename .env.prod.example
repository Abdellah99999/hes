# ==============================================================================
# HES Logistics Platform - Production Environment Variables Template
# ==============================================================================
# DO NOT COMMIT REAL CREDENTIALS. Copy to .env.prod on target server or inject
# via cloud provider secrets management (e.g. AWS Secrets Manager, Vault, GitHub Secrets).

# Application Configuration
NODE_ENV=production
IMAGE_TAG=latest
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://app.hes.ma,https://admin.hes.ma

# PostgreSQL Production Database (Internal Docker network only)
DB_USER=hes_prod_user
DB_PASSWORD=GENERATE_SECURE_STRONG_DB_PASSWORD_MIN_32_CHARS
DB_NAME=hes_delivery_prod

# Redis Cache Production (Internal Docker network only)
REDIS_PASSWORD=GENERATE_SECURE_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# MinIO Production Object Storage (Internal Docker network only)
MINIO_ACCESS_KEY=GENERATE_SECURE_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=GENERATE_SECURE_MINIO_SECRET_KEY
MINIO_BUCKET_DOCS=hes-documents-prod
MINIO_BUCKET_POD=hes-proof-of-delivery-prod

# Cryptographic & Authentication Secrets
# Generate using: openssl rand -base64 64
JWT_ACCESS_SECRET=GENERATE_SECURE_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_SECURE_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
