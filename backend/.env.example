# Backend environment example
# This file is a template only. Actual local secrets stay in backend/.env
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME="Car Rental Platform"

# PostgreSQL local development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_dev_password
DB_NAME=delivery
DATABASE_URL="postgresql://postgres:change_me_dev_password@localhost:5432/delivery?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL="redis://:change_me_redis_password@localhost:6379"

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_BUCKET_DOCS=hes-documents
MINIO_BUCKET_POD=hes-proof-of-delivery

# Security
JWT_ACCESS_SECRET=change_this_jwt_access_secret
JWT_REFRESH_SECRET=change_this_jwt_refresh_secret
CORS_ORIGIN="http://localhost:5173,http://localhost:8080,http://localhost"
