model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  familyId  String?  @map("family_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Route {
  id                      String         @id @default(uuid())
  code                    String         @unique
  name                    String
  originAgencyId          String         @map("origin_agency_id")
  destinationAgencyId     String         @map("destination_agency_id")
  distanceKm              Decimal?       @map("distance_km")
  estimatedDurationMinutes Int?          @map("estimated_duration_minutes")
  isActive                Boolean        @default(true) @map("is_active")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  originAgency Agency       @relation("RouteOriginAgency", fields: [originAgencyId], references: [id])
  destinationAgency Agency @relation("RouteDestinationAgency", fields: [destinationAgencyId], references: [id])
  segments   RouteSegment[]

  @@map("routes")
}

model RouteSegment {
  id                      String   @id @default(uuid())
  routeId                 String   @map("route_id")
  fromAgencyId            String   @map("from_agency_id")
  toAgencyId              String   @map("to_agency_id")
  segmentOrder           Int      @default(1) @map("segment_order")
  estimatedTransitHours   Decimal? @map("estimated_transit_hours")
  distanceKm              Decimal? @map("distance_km")
  estimatedDurationMinutes Int?    @map("estimated_duration_minutes")
  createdAt               DateTime @default(now()) @map("created_at")

  route      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  fromAgency Agency @relation("RouteSegmentFromAgency", fields: [fromAgencyId], references: [id])
  toAgency   Agency @relation("RouteSegmentToAgency", fields: [toAgencyId], references: [id])

  @@map("route_segments")
}

model DeliveryRunItem {
  deliveredAt        DateTime? @map("delivered_at")
  recipientSignature String?   @map("recipient_signature")
  collectedCod       Decimal?  @map("collected_cod")
  id            String        @id @default(uuid())
  deliveryRunId String        @map("delivery_run_id")
  parcelId      String        @map("parcel_id")
  sequenceOrder Int           @default(1) @map("sequence_order")
  status        RunItemStatus @default(PENDING)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  deliveryRun DeliveryRun @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  parcel      Parcel      @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([deliveryRunId, parcelId])
  @@index([parcelId])
  @@index([deliveryRunId, status])
  @@map("delivery_run_items")
}

model DeliveryAttempt {
  deliveryRunId      String?        @map("delivery_run_id")
  attemptNumber      Int            @default(1) @map("attempt_number")
  collectedCodAmount Decimal?       @map("collected_cod_amount")
  courierNotes       String?        @map("courier_notes")
  reason             String?
  refusalReasonId    String?        @map("refusal_reason_id")
  refusalReason      RefusalReason? @relation(fields: [refusalReasonId], references: [id], onDelete: SetNull)
  proofs             DeliveryProof[]
  id          String        @id @default(uuid())
  parcelId    String        @map("parcel_id")
  courierId   String?       @map("courier_id")
  attemptType AttemptType   @default(DELIVERY) @map("attempt_type")
  result      AttemptResult @default(SUCCESS)
  notes       String?
  attemptedAt DateTime      @default(now()) @map("attempted_at")

  parcel  Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  courier User?  @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@index([parcelId])
  @@map("delivery_attempts")
}

model DeliveryProof {
  deliveryAttemptId  String?          @map("delivery_attempt_id")
  deliveryAttempt    DeliveryAttempt? @relation(fields: [deliveryAttemptId], references: [id], onDelete: SetNull)
  proofType          ProofType        @default(DIGITAL_SIGNATURE) @map("proof_type")
  podMethod          String?          @map("pod_method")
  signatureDataUrl   String?          @map("signature_data_url")
  signaturePath      String?          @map("signature_path")
  photoPath          String?          @map("photo_path")
  podPhotoStorageKey String?          @map("pod_photo_storage_key")
  registeredByUserId String?          @map("registered_by_user_id")
  id           String   @id @default(uuid())
  parcelId     String   @map("parcel_id")
  deliveryId   String?  @map("delivery_id")
  signatureUrl String?  @map("signature_url")
  photoUrl     String?  @map("photo_url")
  otpCode      String?  @map("otp_code")
  signerName   String?  @map("signer_name")
  signerCin    String?  @map("signer_cin")
  latitude     Float?
  longitude    Float?
  capturedAt   DateTime @default(now()) @map("captured_at")

  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@index([parcelId])
  @@map("delivery_proofs")
}

model CustomerType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  customers Customer[]

  @@map("customer_types")
}

model CustomerInternalManager {
  assignedByUserId String?  @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  unassignedAt     DateTime? @map("unassigned_at")
  isCurrent        Boolean  @default(true) @map("is_current")
  assignmentReason String?  @map("assignment_reason")
  agencyId         String?  @map("agency_id")
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation("ManagerAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("ManagerAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([customerId, userId])
  @@map("customer_internal_managers")
}

model ParcelType {
  parcels     Parcel[]
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("parcel_types")
}

model ShipmentSequence {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  year         Int
  currentValue Int      @default(0) @map("current_value")
  prefix       String   @default("HES")
  updatedAt    DateTime @updatedAt @map("updated_at")

