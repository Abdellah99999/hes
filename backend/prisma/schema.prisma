model ReturnItem {
  id          String    @id @default(uuid())
  returnId    String    @map("return_id")
  parcelId    String    @map("parcel_id")
  reason      String?
  status      String    @default("PENDING")
  scannedAt   DateTime? @map("scanned_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  returnDoc Return @relation("ReturnDocRelation", fields: [returnId], references: [id], onDelete: Cascade)
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Restrict)

  @@unique([returnId, parcelId])
  @@index([returnId])
  @@index([parcelId])
  @@map("return_items")
}

model Incident {
  awardedAmount   Decimal?          @map("awarded_amount")
  claimedAmount   Decimal?          @map("claimed_amount")
  resolutionNotes String?           @map("resolution_notes")
  history         IncidentHistory[]
  id             String          @id @default(uuid())
  number         String          @unique
  shipmentId     String          @map("shipment_id")
  parcelId       String?         @map("parcel_id")
  agencyId       String          @map("agency_id")
  createdByUserId String?        @map("created_by_user_id")
  type           IncidentType
  severity       IncidentSeverity @default(MEDIUM)
  status         IncidentStatus @default(REPORTED)
  description    String
  resolution     String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  shipment      Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  parcel        Parcel?     @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  agency        Agency      @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdByUser User?       @relation("IncidentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  complaints    Complaint[]

  @@index([shipmentId])
  @@index([parcelId])
  @@index([agencyId, status])
  @@map("incidents")
}

model Complaint {
  id          String         @id @default(uuid())
  number      String         @unique
  shipmentId  String?        @map("shipment_id")
  parcelId    String?        @map("parcel_id")
  customerId  String         @map("customer_id")
  incidentId  String?        @map("incident_id")
  title       String
  description String
  status      IncidentStatus @default(REPORTED)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  parcel   Parcel?   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@map("complaints")
}

model Invoice {
  invoiceNumber  String?     @unique @map("invoice_number")
  invoiceDate    DateTime    @default(now()) @map("invoice_date")
  createdById     String?    @map("created_by_id")
  createdBy      User?       @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  id          String        @id @default(uuid())
  number      String        @unique
  customerId  String        @map("customer_id")
  agencyId    String        @map("agency_id")
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now()) @map("issue_date")
  dueDate     DateTime?     @map("due_date")
  subtotal    Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0.00) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount Decimal       @db.Decimal(12, 2) @map("total_amount")
  paidAmount  Decimal       @default(0.00) @db.Decimal(12, 2) @map("paid_amount")
  currency    String        @default("MAD")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  agency      Agency            @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  items       InvoiceItem[]
  payments    Payment[]
  refunds     Refund[]
  creditNotes CreditNote[]
  paymentAllocations PaymentAllocation[] @relation("InvoicePaymentAllocations")

  @@index([customerId])
  @@index([agencyId, status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  shipmentId  String?  @map("shipment_id")
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2) @map("unit_price")
  totalPrice  Decimal  @default(0) @db.Decimal(12, 2) @map("total_price")
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String        @map("invoice_id")
  shipmentId    String?       @map("shipment_id")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice     Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  shipment    Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  cod         COD?

  @@index([invoiceId])
  @@index([shipmentId])
  @@index([status])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(uuid())
  paymentId String   @map("payment_id")
  invoiceId String   @map("invoice_id")
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation("InvoicePaymentAllocations", fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model COD {
  id          String   @id @default(uuid())
  paymentId   String   @unique @map("payment_id")
  shipmentId  String   @map("shipment_id")
  amount      Decimal  @db.Decimal(12, 2)
  collectedAt DateTime? @map("collected_at")
  createdAt   DateTime @default(now()) @map("created_at")

  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  shipment Shipment @relation("ShipmentCOD", fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("cod")
}

model Refund {
  id        String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  amount     Decimal  @db.Decimal(12, 2)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("refunds")
}

model CreditNote {
  id        String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  number    String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("credit_notes")
}

model Expense {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @map("expense_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId, expenseDate])
  @@map("expenses")
}

model DocumentTemplate {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  documentType DocumentType @map("document_type")
  bodyHtml    String?      @map("body_html")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  documents Document[]

  @@map("document_templates")
}

model Document {
  id                String       @id @default(uuid())
  number            String       @unique
  documentType      DocumentType @map("document_type")
  templateId        String?      @map("template_id")
  shipmentId        String?      @map("shipment_id")
  parcelId          String?      @map("parcel_id")
  customerId        String?      @map("customer_id")
  agencyId          String?      @map("agency_id")
  generatedByUserId String?      @map("generated_by_user_id")
  storageKey        String       @map("storage_key")
  fileName          String       @map("file_name")
  mimeType          String       @default("application/pdf") @map("mime_type")
  checksum          String?
  createdAt         DateTime     @default(now()) @map("created_at")

  template       DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  shipment       Shipment?         @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  parcel         Parcel?           @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agency         Agency?           @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  generatedByUser User?            @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([documentType])
  @@index([shipmentId])
  @@index([parcelId])
  @@index([customerId])
  @@index([agencyId])
  @@map("documents")
}

model NotificationPreference {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  channel   NotificationChannel
  enabled   Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model Notification {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus @default(PENDING)
  title     String
  body      String
  metadata  Json?
  sentAt    DateTime?         @map("sent_at")
  readAt    DateTime?         @map("read_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([channel])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  agencyId   String?     @map("agency_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([agencyId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}


